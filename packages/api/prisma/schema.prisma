// STARK.WMS — Data model
// Layered enterprise WMS: master data, warehouse structure, inventory,
// receiving, task engine, orders/allocation/picking, waves, replenishment,
// counts, quality, packing/shipping, audit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------------

enum RoleCode {
  ADMIN
  MANAGER
  SUPERVISOR
  OPERATOR
  CHECKER
  SHIPPING
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OperatorStatus {
  AVAILABLE
  BUSY
  PAUSED
  OFFLINE
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  code        RoleCode         @unique
  name        String
  description String?
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                String         @id @default(cuid())
  matricula         String         @unique
  name              String
  email             String         @unique
  passwordHash      String
  roleId            String
  role              Role           @relation(fields: [roleId], references: [id])
  shift             String?
  status            UserStatus     @default(ACTIVE)
  operatorStatus    OperatorStatus @default(OFFLINE)
  authorizedZones   String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  assignedTasks     Task[]              @relation("TaskAssignee")
  taskAssignments   TaskAssignment[]
  movements         Movement[]
  auditLogs         AuditLog[]
  receiptsChecked   Receipt[]           @relation("ReceiptOperator")
  discrepanciesOpen Discrepancy[]       @relation("DiscrepancyCreatedBy")
  discrepanciesRes  Discrepancy[]       @relation("DiscrepancyResolvedBy")
  qualityInspected  QualityInspection[] @relation("InspectedBy")

  @@index([roleId])
}

// ---------------------------------------------------------------------------
// MASTER DATA
// ---------------------------------------------------------------------------

enum GenericStatus {
  ACTIVE
  INACTIVE
}

enum ProductType {
  STANDARD
  KIT
  BULK
  FRAGILE
  PERISHABLE
}

model UnitOfMeasure {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isBase    Boolean  @default(false)
  createdAt DateTime @default(now())

  productsBase    Product[]        @relation("ProductBaseUom")
  conversionsFrom UomConversion[]  @relation("ConversionFrom")
  conversionsTo   UomConversion[]  @relation("ConversionTo")
  orderItems      OrderItem[]
}

model UomConversion {
  id         String        @id @default(cuid())
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUomId  String
  fromUom    UnitOfMeasure @relation("ConversionFrom", fields: [fromUomId], references: [id])
  toUomId    String
  toUom      UnitOfMeasure @relation("ConversionTo", fields: [toUomId], references: [id])
  factor     Float

  @@unique([productId, fromUomId, toUomId])
}

model Category {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  status      GenericStatus @default(ACTIVE)
  products    Product[]
}

model Product {
  id             String        @id @default(cuid())
  sku            String        @unique
  internalCode   String        @unique
  barcode        String?       @unique
  description    String
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  baseUomId      String
  baseUom        UnitOfMeasure @relation("ProductBaseUom", fields: [baseUomId], references: [id])
  weightKg       Float
  lengthCm       Float
  widthCm        Float
  heightCm       Float
  volumeM3       Float
  type           ProductType   @default(STANDARD)
  lotControl     Boolean       @default(false)
  expiryControl  Boolean       @default(false)
  serialControl  Boolean       @default(false)
  minStock       Int           @default(0)
  maxStock       Int           @default(0)
  status         GenericStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversions        UomConversion[]
  lots               Lot[]
  balances           InventoryBalance[]
  movements          Movement[]
  receiptItems       ReceiptItem[]
  orderItems         OrderItem[]
  allocations        Allocation[]
  discrepancies      Discrepancy[]
  replenishmentTasks ReplenishmentTask[]
  countItems         InventoryCountItem[]
  qualityInspections QualityInspection[]
  pickingTasks       PickingTask[]
  tasks              Task[]

  @@index([categoryId])
}

model Supplier {
  id        String        @id @default(cuid())
  code      String        @unique
  legalName String
  cnpj      String        @unique
  contacts  Json?
  address   Json?
  status    GenericStatus @default(ACTIVE)
  receipts  Receipt[]
  lots      Lot[]
}

model Customer {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  document  String        @unique
  contacts  Json?
  address   Json?
  status    GenericStatus @default(ACTIVE)
  orders    Order[]
}

model Carrier {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  document  String        @unique
  contacts  Json?
  status    GenericStatus @default(ACTIVE)
  orders    Order[]
  shipments Shipment[]
}

// ---------------------------------------------------------------------------
// WAREHOUSE STRUCTURE
// ---------------------------------------------------------------------------

enum LocationType {
  PICKING
  RESERVE
  RECEIVING
  STAGING
  SHIPPING
  QUARANTINE
  CROSS_DOCK
}

enum LocationStatus {
  ACTIVE
  BLOCKED
  FULL
  INACTIVE
}

model Warehouse {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  address   Json?
  status    GenericStatus @default(ACTIVE)
  zones     Zone[]
  docks     Dock[]
  createdAt DateTime      @default(now())
}

model Zone {
  id          String        @id @default(cuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  code        String
  name        String
  type        LocationType
  status      GenericStatus @default(ACTIVE)
  locations   Location[]

  @@unique([warehouseId, code])
}

model Location {
  id             String         @id @default(cuid())
  zoneId         String
  zone           Zone           @relation(fields: [zoneId], references: [id])
  aisle          String
  rack           String
  level          String
  position       String
  fullCode       String         @unique
  type           LocationType
  status         LocationStatus @default(ACTIVE)
  capacityQty    Int
  maxWeightKg    Float
  maxVolumeM3    Float
  occupiedQty    Int            @default(0)
  characteristics Json?
  pickingMin     Int?
  pickingMax     Int?
  createdAt      DateTime       @default(now())

  balances            InventoryBalance[]
  movementsFrom        Movement[]           @relation("MovementFrom")
  movementsTo          Movement[]           @relation("MovementTo")
  putawayTasksTo       Task[]               @relation("TaskDestLocation")
  putawayTasksFrom     Task[]               @relation("TaskOriginLocation")
  pickingTasks         PickingTask[]
  replenishmentFrom    ReplenishmentTask[]  @relation("ReplenishFrom")
  replenishmentTo      ReplenishmentTask[]  @relation("ReplenishTo")
  countItems           InventoryCountItem[]
  qualityInspections   QualityInspection[]
  allocations          Allocation[]

  @@index([zoneId])
  @@index([type])
}

model Dock {
  id          String        @id @default(cuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  code        String
  type        String // RECEIVING | SHIPPING
  status      GenericStatus @default(ACTIVE)
  receipts    Receipt[]
  shipments   Shipment[]

  @@unique([warehouseId, code])
}

// ---------------------------------------------------------------------------
// INVENTORY
// ---------------------------------------------------------------------------

enum LotStatus {
  ACTIVE
  QUARANTINE
  BLOCKED
  EXPIRED
}

model Lot {
  id              String    @id @default(cuid())
  code            String
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  manufactureDate DateTime?
  expiryDate      DateTime?
  status          LotStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())

  balances     InventoryBalance[]
  movements    Movement[]
  receiptItems ReceiptItem[]
  allocations  Allocation[]
  countItems   InventoryCountItem[]
  qualityInspections QualityInspection[]

  @@unique([productId, code])
}

model InventoryBalance {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  locationId     String
  location       Location @relation(fields: [locationId], references: [id])
  lotId          String?
  lot            Lot?     @relation(fields: [lotId], references: [id])
  qtyPhysical    Int      @default(0)
  qtyAvailable   Int      @default(0)
  qtyReserved    Int      @default(0)
  qtyBlocked     Int      @default(0)
  qtyQuarantine  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, locationId, lotId])
  @@index([productId])
  @@index([locationId])
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model InventoryReservation {
  id          String             @id @default(cuid())
  orderItemId String
  orderItem   OrderItem          @relation(fields: [orderItemId], references: [id])
  productId   String
  locationId  String?
  lotId       String?
  qty         Int
  status      ReservationStatus  @default(ACTIVE)
  createdAt   DateTime           @default(now())
}

enum MovementType {
  RECEIPT
  PUTAWAY
  PICK
  REPLENISH
  TRANSFER
  ADJUST
  BLOCK
  UNBLOCK
  QUARANTINE
  RELEASE
  CONSOLIDATE
  DECONSOLIDATE
  SHIP
  COUNT_ADJUST
}

model Movement {
  id             String       @id @default(cuid())
  type           MovementType
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  lotId          String?
  lot            Lot?         @relation(fields: [lotId], references: [id])
  qty            Int
  fromLocationId String?
  fromLocation   Location?    @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location?    @relation("MovementTo", fields: [toLocationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  reason         String?
  refType        String?
  refId          String?
  createdAt      DateTime     @default(now())

  @@index([productId])
  @@index([refType, refId])
}

// ---------------------------------------------------------------------------
// RECEIVING
// ---------------------------------------------------------------------------

enum ReceiptStatus {
  SCHEDULED
  ARRIVED
  AT_DOCK
  IN_CONFERENCE
  CONFERRED
  PUTAWAY
  COMPLETED
  CANCELLED
}

model Receipt {
  id            String        @id @default(cuid())
  number        String        @unique
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  scheduledDate DateTime
  arrivalDate   DateTime?
  dockId        String?
  dock          Dock?         @relation(fields: [dockId], references: [id])
  status        ReceiptStatus @default(SCHEDULED)
  crossDock     Boolean       @default(false)
  operatorId    String?
  operator      User?         @relation("ReceiptOperator", fields: [operatorId], references: [id])
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         ReceiptItem[]
  tasks         Task[]        @relation("TaskReceipt")

  @@index([status])
}

enum ReceiptItemStatus {
  PENDING
  CHECKED
  DIVERGENT
  PUT_AWAY
}

model ReceiptItem {
  id           String            @id @default(cuid())
  receiptId    String
  receipt      Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  expectedQty  Int
  receivedQty  Int               @default(0)
  lotId        String?
  lot          Lot?              @relation(fields: [lotId], references: [id])
  damagedQty   Int               @default(0)
  status       ReceiptItemStatus @default(PENDING)

  @@index([receiptId])
}

// ---------------------------------------------------------------------------
// TASK ENGINE (generic orchestration envelope)
// ---------------------------------------------------------------------------

enum TaskType {
  RECEIVING
  CONFERENCE
  PUTAWAY
  PICKING
  REPLENISHMENT
  TRANSFER
  COUNT
  SHIPPING
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

model Task {
  id               String       @id @default(cuid())
  type             TaskType
  priority         TaskPriority @default(NORMAL)
  status           TaskStatus   @default(PENDING)
  refType          String
  refId            String
  originLocationId String?
  originLocation   Location?    @relation("TaskOriginLocation", fields: [originLocationId], references: [id])
  destLocationId   String?
  destLocation     Location?    @relation("TaskDestLocation", fields: [destLocationId], references: [id])
  productId        String?
  product          Product?     @relation(fields: [productId], references: [id])
  qty              Int?
  equipment        String?
  assignedToId     String?
  assignedTo       User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  slaDueAt         DateTime?
  cancelReason     String?
  createdAt        DateTime     @default(now())
  startedAt        DateTime?
  completedAt      DateTime?

  receiptId  String?
  receipt    Receipt?         @relation("TaskReceipt", fields: [receiptId], references: [id])
  assignments TaskAssignment[]

  @@index([type, status])
  @@index([refType, refId])
  @@index([assignedToId])
}

model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
  releasedAt DateTime?
}

// ---------------------------------------------------------------------------
// ORDERS / RESERVATION / ALLOCATION / PICKING
// ---------------------------------------------------------------------------

enum OrderPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum OrderStatus {
  RECEIVED
  RELEASED
  ALLOCATED
  PICKING
  PICKED
  CONFERENCE
  PACKING
  STAGING
  READY
  SHIPPED
  CANCELLED
}

model Order {
  id            String        @id @default(cuid())
  number        String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  orderDate     DateTime      @default(now())
  priority      OrderPriority @default(NORMAL)
  slaDueAt      DateTime?
  status        OrderStatus   @default(RECEIVED)
  shippingAddress Json?
  carrierId     String?
  carrier       Carrier?      @relation(fields: [carrierId], references: [id])
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items      OrderItem[]
  waveLinks  WaveOrder[]
  packages   Package[]
  shipments  Shipment[]

  @@index([status])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  uomId        String
  uom          UnitOfMeasure @relation(fields: [uomId], references: [id])
  qtyOrdered   Int
  qtyAllocated Int      @default(0)
  qtyPicked    Int      @default(0)
  qtyShipped   Int      @default(0)

  reservations InventoryReservation[]
  allocations  Allocation[]
  pickingTasks PickingTask[]
  packageItems PackageItem[]

  @@index([orderId])
  @@index([productId])
}

enum AllocationStatus {
  PENDING
  PICKED
  CANCELLED
}

model Allocation {
  id          String            @id @default(cuid())
  orderItemId String
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id])
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  lotId       String?
  lot         Lot?              @relation(fields: [lotId], references: [id])
  locationId  String
  location    Location          @relation(fields: [locationId], references: [id])
  qty         Int
  status      AllocationStatus  @default(PENDING)
  createdAt   DateTime          @default(now())
}

enum WaveStatus {
  CREATED
  RELEASED
  PAUSED
  CANCELLED
  COMPLETED
}

model PickWave {
  id          String     @id @default(cuid())
  code        String     @unique
  status      WaveStatus @default(CREATED)
  criteria    Json?
  createdAt   DateTime   @default(now())
  releasedAt  DateTime?
  completedAt DateTime?

  orders       WaveOrder[]
  pickingTasks PickingTask[]
}

model WaveOrder {
  waveId  String
  wave    PickWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  orderId String
  order   Order    @relation(fields: [orderId], references: [id])

  @@id([waveId, orderId])
}

enum PickingTaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model PickingTask {
  id           String            @id @default(cuid())
  waveId       String?
  wave         PickWave?         @relation(fields: [waveId], references: [id])
  orderItemId  String
  orderItem    OrderItem         @relation(fields: [orderItemId], references: [id])
  productId    String
  product      Product           @relation(fields: [productId], references: [id])
  lotId        String?
  locationId   String
  location     Location          @relation(fields: [locationId], references: [id])
  qtySuggested Int
  qtyPicked    Int               @default(0)
  sequence     Int               @default(0)
  strategy     String            @default("FEFO")
  operatorId   String?
  status       PickingTaskStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  completedAt  DateTime?

  @@index([waveId])
  @@index([orderItemId])
}

// ---------------------------------------------------------------------------
// REPLENISHMENT
// ---------------------------------------------------------------------------

enum ReplenishmentStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ReplenishmentTask {
  id             String               @id @default(cuid())
  productId      String
  product        Product              @relation(fields: [productId], references: [id])
  fromLocationId String
  fromLocation   Location             @relation("ReplenishFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location             @relation("ReplenishTo", fields: [toLocationId], references: [id])
  qty            Int
  status         ReplenishmentStatus  @default(PENDING)
  operatorId     String?
  createdAt      DateTime             @default(now())
  completedAt    DateTime?
}

// ---------------------------------------------------------------------------
// DISCREPANCIES
// ---------------------------------------------------------------------------

enum DiscrepancyType {
  SHORTAGE
  OVERAGE
  WRONG_PRODUCT
  WRONG_LOT
  EXPIRY
  DAMAGE
  DOCUMENT
  ADDRESS
}

enum DiscrepancyStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CANCELLED
}

model Discrepancy {
  id               String            @id @default(cuid())
  type             DiscrepancyType
  status           DiscrepancyStatus @default(OPEN)
  refType          String
  refId            String
  productId        String?
  product          Product?          @relation(fields: [productId], references: [id])
  expectedQty      Int?
  actualQty        Int?
  description      String
  createdById      String
  createdBy        User              @relation("DiscrepancyCreatedBy", fields: [createdById], references: [id])
  resolvedById     String?
  resolvedBy       User?             @relation("DiscrepancyResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt       DateTime?
  resolutionAction String?
  resolutionNotes  String?
  createdAt        DateTime          @default(now())

  @@index([refType, refId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// INVENTORY COUNT
// ---------------------------------------------------------------------------

enum CountType {
  GENERAL
  PARTIAL
  CYCLE
}

enum CountStatus {
  OPEN
  COUNTING
  REVIEW
  DISCREPANCY
  RECOUNT
  APPROVAL
  ADJUSTMENT
  COMPLETED
  CANCELLED
}

model InventoryCount {
  id        String      @id @default(cuid())
  code      String      @unique
  type      CountType
  scope     Json?
  status    CountStatus @default(OPEN)
  createdAt DateTime    @default(now())
  closedAt  DateTime?

  items InventoryCountItem[]
}

enum CountItemStatus {
  PENDING
  COUNTED
  DIVERGENT
  RECOUNTED
  APPROVED
  ADJUSTED
}

model InventoryCountItem {
  id            String          @id @default(cuid())
  countId       String
  count         InventoryCount  @relation(fields: [countId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location        @relation(fields: [locationId], references: [id])
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  lotId         String?
  lot           Lot?            @relation(fields: [lotId], references: [id])
  systemQty     Int
  countedQty1   Int?
  countedQty2   Int?
  finalQty      Int?
  status        CountItemStatus @default(PENDING)

  @@index([countId])
}

// ---------------------------------------------------------------------------
// QUALITY
// ---------------------------------------------------------------------------

enum QualityStatus {
  PENDING
  INSPECTING
  APPROVED
  REJECTED
}

model QualityInspection {
  id          String        @id @default(cuid())
  refType     String
  refId       String
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  lotId       String?
  lot         Lot?          @relation(fields: [lotId], references: [id])
  locationId  String?
  location    Location?     @relation(fields: [locationId], references: [id])
  qty         Int?
  status      QualityStatus @default(PENDING)
  result      String?
  inspectorId String?
  inspector   User?         @relation("InspectedBy", fields: [inspectorId], references: [id])
  notes       String?
  createdAt   DateTime      @default(now())
  decidedAt   DateTime?
}

// ---------------------------------------------------------------------------
// PACKING / SHIPPING
// ---------------------------------------------------------------------------

enum PackageStatus {
  OPEN
  CLOSED
  SHIPPED
}

model Package {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  code      String        @unique
  weightKg  Float?
  lengthCm  Float?
  widthCm   Float?
  heightCm  Float?
  status    PackageStatus @default(OPEN)
  createdAt DateTime      @default(now())
  closedAt  DateTime?

  items     PackageItem[]
  shipments ShipmentPackage[]
}

model PackageItem {
  id          String    @id @default(cuid())
  packageId   String
  package     Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  qty         Int
}

enum ShipmentStatus {
  STAGING
  DOCK
  LOADING
  SHIPPED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  romaneioNumber String         @unique
  carrierId      String
  carrier        Carrier        @relation(fields: [carrierId], references: [id])
  dockId         String?
  dock           Dock?          @relation(fields: [dockId], references: [id])
  status         ShipmentStatus @default(STAGING)
  loadedAt       DateTime?
  shippedAt      DateTime?
  createdAt      DateTime       @default(now())

  packages ShipmentPackage[]
}

model ShipmentPackage {
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id])

  @@id([shipmentId, packageId])
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
